# Postgres
DATABASE_URL=postgres://bidboard:bidboard@localhost:5432/bidboard

# Public base URL, used for Stripe redirect URLs
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Stripe TEST keys (https://dashboard.stripe.com/test/apikeys)
# Leave STRIPE_SECRET_KEY empty to run in SIMULATED payment mode:
# checkout is skipped and the bid is applied directly, so you can
# exercise the full engine without any Stripe account.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Set to "1" to expose /api/dev/simulate. Never enable in production.
ALLOW_DEV_SIMULATE=1
