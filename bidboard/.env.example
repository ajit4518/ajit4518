# Postgres
DATABASE_URL=postgres://bidboard:bidboard@localhost:5432/bidboard

# Public base URL, used for Stripe redirect URLs
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Stripe TEST keys (https://dashboard.stripe.com/test/apikeys)
# Leave STRIPE_SECRET_KEY empty to run in SIMULATED payment mode:
# checkout is skipped and the bid is applied directly, so you can
# exercise the full engine without any Stripe account.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Set to "1" to expose /api/dev/simulate. Never enable in production.
ALLOW_DEV_SIMULATE=1

# Dev-only: expose /api/auth/mock/start, which creates a verified claim
# without a real provider. Never enable in production.
ALLOW_MOCK_OAUTH=1

# Platform OAuth (all optional; each is disabled until both values are set).
# X:       https://developer.x.com  -> OAuth 2.0, PKCE, callback /api/auth/x/callback
# Google:  https://console.cloud.google.com -> YouTube Data API v3
# TikTok:  https://developers.tiktok.com -> Login Kit
X_CLIENT_ID=
X_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
